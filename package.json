{
  "name": "myspace-dsh-browser-computer",
  "version": "0.1.4",
  "description": "让 DeepSeek Harness 直接操作浏览器与电脑：以插件形式装配 playwright-mcp 与 peekaboo-mcp，并提供一键依赖安装、系统权限引导与连接自检",
  "type": "module",
  "main": "./src/host.mjs",
  "icon": "./icon.png",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "mcp",
    "playwright",
    "peekaboo",
    "browser-automation",
    "computer-use"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fegnze/myspace-dsh-browser-computer.git"
  },
  "homepage": "https://github.com/fegnze/myspace-dsh-browser-computer#readme",
  "bugs": {
    "url": "https://github.com/fegnze/myspace-dsh-browser-computer/issues"
  },
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "icon.png",
    "locale"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
